# Evaluated model: OpenAI-compatible Chat Completions endpoint.
MODEL_API_URL=https://your-provider.example/v1/chat/completions
MODEL_API_KEY=replace_me
MODEL_NAME=your-tool-capable-model
MODEL_REASONING_FIELD=reasoning_content

# Fixed rubric judge. This may point to the same provider, but is kept separate
# so formal runs can pin a single judge across all evaluated models.
JUDGE_API_URL=https://your-judge.example/v1/chat/completions
JUDGE_API_KEY=replace_me
JUDGE_MODEL=your-fixed-judge-model

# Optional LLM used to produce synthetic benchmark pages.
GENERATOR_BASE_URL=https://your-provider.example/v1
GENERATOR_API_KEY=replace_me
GENERATOR_MODEL=your-generator-model

# Optional licensed public-page corpus for the modified-page path.
GEO_REFERENCE_CORPUS=/path/to/licensed_reference_pages.jsonl
GEO_ENVIRONMENTS_CONFIG=configs/environments.json
